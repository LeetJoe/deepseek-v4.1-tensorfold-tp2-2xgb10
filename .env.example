# tf-dsv41 — config for the DeepSeek-V4.1-Flash TP2 head-local launcher.
#
# Copy to .env and edit. Everything below is also the script's built-in default, so .env is
# optional — an empty .env is fine.
#
# Section 1 = the values you normally edit. Sections 2/3 are commented out on purpose:
#   * section 2 = per-worker overrides (leave commented to just reuse the head's values)
#   * section 3 = values that are fine as-is (uncomment only to change one)
#
# In-container mount points are FIXED at /workspace/models and /workspace/cache; only the HOST
# side of each mount is configurable. Other subpaths under models/cache (kit, token map, rank
# cache, logs, tf-build) are literals in the scripts; only WEIGHTS_SUBDIR / ENGRAM_SUBDIR are vars.

# ================= 1. edit these =================
SSH_USER=dgxspark
HEAD_IP=192.168.1.100
WORKER_IP=192.168.1.101
# CX7 interconnect addresses (HEAD_CX_IP doubles as the TP master ip)
HEAD_CX_IP=10.8.8.1
WORKER_CX_IP=10.8.8.2
HEAD_MODELS_DIR=/home/dgxspark/models
HEAD_CACHE_DIR=/home/dgxspark/cache
TENSORFOLD_DIR=/home/dgxspark/code/TensorFold
# the Python engine source (a worktree of the same repo) — only used by prepare.sh, for the
# token map and the A-phase rank cache
TP2_DIR=/home/dgxspark/code/tensorfold-tp2

# ================= 2. per-worker overrides (default = same as head) =================
# WORKER_MODELS_DIR=/home/dgxspark/models
# WORKER_CACHE_DIR=/home/dgxspark/cache
# WORKER_NODEDIR=/home/dgxspark/code/deepseek-v4.1-tensorfold-tp2-2xgb10

# ================= 3. defaults (uncomment only to change) =================
# MODELS_MOUNT=/workspace/models
# CACHE_MOUNT=/workspace/cache
# CONTAINER=tf-dsv41
# IMAGE=ghcr.io/leetjoe/deepseekv41flash_tensorfold:v1.0.0
# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=8888
# TP_MASTER_PORT=29620
# TP_WORLD=2
# WEIGHTS_SUBDIR=DeepSeek-V4.1-Flash-UNCENSORED-EXL3-2.9bpw
# ENGRAM_SUBDIR=DeepSeek-V4.1-Flash
# NCCL_IB_HCA=roceP2p1s0f1,rocep1s0f1
# NCCL_IB_GID_INDEX=5
# NCCL_SOCKET_IFNAME=enP2p1s0f1np1
# NCCL_NET_PLUGIN=spcx
# MODEL_NAME=DeepSeek-V4.1-Flash-TF
# CONTEXT=1048576
# PARALLEL=4
# MAX_TOKENS=32768
# TEMPERATURE=1.0
# TOP_P=0.95
# TOP_K=20
# BACKEND=cuda
# POOL=1048576
# READY_TIMEOUT_S=360
# READY_INTERVAL_S=5
# SMOKE_TIMEOUT_S=120

# ================= 4. prepare.sh only (uncomment only to change) =================
# TENSORFOLD_REPO=https://github.com/bertholomus/TensorFold.git
# TENSORFOLD_BRANCH=deepseek-v41-zig
# TP2_BRANCH=deepseek-v41-tp2
# WEIGHTS_REPO=Mia-AiLab/DeepSeek-V4.1-Flash-EXL3-2.9bpw
# ENGRAM_REPO=deepseek-ai/DeepSeek-V4.1-Flash
# ENGRAM_SHARDS=47 48
# ZIG_VERSION=0.17.0
# ZIG_DIR=/home/dgxspark/tools/zig-aarch64-linux-0.17.0
